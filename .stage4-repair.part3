
{
  let s=read('prompt-engine.js');
  s=mustReplace(s,"const PROMPT_ENGINE_VERSION='closed-loop-prompt-engine/25';","const PROMPT_ENGINE_VERSION='closed-loop-prompt-engine/26';",'prompt version');
  s=mustReplace(s,"contractVersion:'closed-loop-response-contract/2.4'","contractVersion:'closed-loop-response-contract/3'",'prompt response contract');
  s=mustReplace(s,"1:'Initialize only this current job from this current job’s exact user input.","1:'Initialize only this current job from this current job’s exact user input. Account for every INPUT-UNIT identity supplied by the application exactly once in INTAKE_ACCOUNTING using only inputUnitId, disposition, and reason. Allowed dispositions are INCORPORATED_INTO_JOB_DEFINITION, RETAINED_AS_CONTEXT, UNRESOLVED_HUMAN_ONLY, LATER_RESOLVABLE, or INAPPLICABLE. Never omit an INPUT-UNIT. ",'Stage 01 accounting procedure');
  s=mustReplace(s,"4:'Compile atomic requirement proposals only from the complete current canonical input union selected by the application:","4:'Compile atomic requirement proposals only from the complete current canonical input union selected by the application. Account for every OBLIGATION identity supplied by the application exactly once in OBLIGATION_ACCOUNTING using only obligationId, disposition, requirementTempKeys, and reason. Allowed dispositions are REQUIREMENT, RETAINED_CONTEXT, INAPPLICABLE, or BLOCKED. REQUIREMENT must map to one or more current response requirement tempKeys; every other disposition must give a reason and no requirementTempKeys. Never omit an OBLIGATION. The complete current canonical input union is:",'Stage 04 accounting procedure');
  s=mustReplace(s,'function contextFor(stage,state,operation,scope={}){\n const parts=[];','function contextFor(stage,state,operation,scope={}){\n const parts=[];\n if(stage===1){const manifest=workflow.currentIntakeCoverageManifest(state);parts.push(`APPLICATION-OWNED STAGE 01 INTAKE COVERAGE MANIFEST — ACCOUNT FOR EVERY ID EXACTLY ONCE\\n${show({manifestId:manifest.manifestId,inputVersion:manifest.inputVersion,inputSha256:manifest.inputSha256,units:manifest.units})}`);}\n if(stage===4){const manifest=workflow.currentObligationManifest(state);parts.push(`APPLICATION-OWNED STAGE 04 OBLIGATION MANIFEST — ACCOUNT FOR EVERY ID EXACTLY ONCE\\n${show({manifestId:manifest.manifestId,inputVersion:manifest.inputVersion,sourceSetVersion:manifest.sourceSetVersion,intakeManifestId:manifest.intakeManifestId,obligations:manifest.obligations})}`);}','prompt manifest context');
  s=mustReplace(s,'executionHandoff:promptHandoff,readCollections:',"executionHandoff:promptHandoff,intakeCoverageManifest:stage===1?workflow.intakeManifestContext(state):null,obligationManifest:stage===4?workflow.obligationManifestContext(state):null,readCollections:",'context signature binds manifests');
  write('prompt-engine.js',s);
}

{
  let s=read('response-ingestion.js');
  const insertAnchor='  const allowedCollections=new Set(operationContract?.agentWritableCollections||contract?.agentWritableCollections||contract?.allowedCollections||[]);';
  const accountingValidation=`  if(envelope.responseType==='DATA_PROPOSAL'&&stageNumber===1){const evaluation=workflow.evaluateIntakeAccounting(project,envelope.stageData?.INTAKE_ACCOUNTING);for(const message of evaluation.issues)issues.push(issue('INCOMPLETE_INTAKE_ACCOUNTING','/stageData/INTAKE_ACCOUNTING',message));}\n  if(envelope.responseType==='DATA_PROPOSAL'&&stageNumber===4){const requirementTempKeys=safe(envelope.records?.requirements).map(record=>record?.tempKey).filter(Boolean),evaluation=workflow.evaluateObligationAccounting(project,envelope.stageData?.OBLIGATION_ACCOUNTING,{requirementTempKeys});for(const message of evaluation.issues)issues.push(issue('INCOMPLETE_OBLIGATION_ACCOUNTING','/stageData/OBLIGATION_ACCOUNTING',message));}\n\n${insertAnchor}`;
  s=mustReplace(s,insertAnchor,accountingValidation,'response accounting validation');
  write('response-ingestion.js',s);
}

{
  let s=read('app-core.js');
  s=s.replaceAll("[core.SCHEMA,'human-project/30']","[core.SCHEMA,'closed-loop-project/2','human-project/30']");
  const artifactAnchor="function artifactControlMarkup(n,locked){if(n===19)return";
  mustInclude(s,artifactAnchor,'artifact control');
  s=s.replace(artifactAnchor,"function artifactControlMarkup(n,locked){if(n===4){const intake=engine.currentIntakeCoverageManifest(current),obligations=engine.currentObligationManifest(current);return `<div class=\"panel\"><h2 class=\"section-title\">Captured project intent</h2><p class=\"section-intro\">Stage 04 uses the canonical material captured in Stage 01 plus current Stage 03 research. Do not reattach or re-enter the original intent file. If this manifest is incomplete, the application returns to the responsible earlier stage instead of asking you for the same material again.</p><div class=\"stage-action-strip\"><span>Intake manifest: <strong>${'${esc(intake.manifestId)}'}</strong></span><span>Obligation manifest: <strong>${'${esc(obligations.manifestId)}'}</strong></span></div></div>`;}if(n===19)return");
  s=mustReplace(s,"['Extraction manifests',d.extractionManifests],['Human input requests'","['Extraction manifests',d.extractionManifests],['Stage 01 intake coverage manifests',d.intakeCoverageManifests],['Stage 04 obligation manifests',d.obligationManifests],['Human input requests'",'records manifest groups');
  write('app-core.js',s);
}

fs.copyFileSync('.stage4-regression.tmp','verify-stage4-intent-reuse.mjs');

for(const file of ['.stage4-engine-helper.tmp','.stage4-regression.tmp','.stage4-repair.mjs','.github/workflows/stage4-repair.yml'])if(fs.existsSync(file))fs.rmSync(file);
console.log('Applied Stage 01/04 canonical intent capture repair.');
