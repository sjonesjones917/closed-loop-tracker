
const INTAKE_ACCOUNTING_DISPOSITIONS=Object.freeze(['INCORPORATED_INTO_JOB_DEFINITION','RETAINED_AS_CONTEXT','UNRESOLVED_HUMAN_ONLY','LATER_RESOLVABLE','INAPPLICABLE']);
const OBLIGATION_ACCOUNTING_DISPOSITIONS=Object.freeze(['REQUIREMENT','RETAINED_CONTEXT','INAPPLICABLE','BLOCKED']);
function materialUnitValues(value){
  if(value===undefined||value===null)return [];
  if(Array.isArray(value))return value.flatMap(materialUnitValues);
  if(value&&typeof value==='object')return Object.entries(value).flatMap(([key,item])=>materialUnitValues(typeof item==='string'?`${key}: ${item}`:{[key]:item}));
  const text=String(value).replace(/\r\n?/g,'\n').trim();if(!text)return [];
  if((text.startsWith('[')&&text.endsWith(']'))||(text.startsWith('{')&&text.endsWith('}'))){try{return materialUnitValues(JSON.parse(text));}catch{}}
  const lines=text.split(/\n+/).map(x=>x.trim()).filter(Boolean);return lines.length?lines:[text];
}
function inputPayload(project){
  const current=String(project.job.CURRENT_INPUT_VERSION||''),version=safe(project.projectData.inputVersions).findLast?.(item=>String(item.version)===current)||safe(project.projectData.inputVersions).filter(item=>String(item.version)===current).at(-1);
  if(version?.payload)return clone(version.payload);
  const payload=Object.fromEntries((globalThis.closedLoopWorkflowSchema?.HUMAN_INTAKE_FIELDS||[]).map(name=>[name,clone(project.job[name])]))
  payload.clarifications=safe(project.projectData.humanInputAnswers).filter(item=>!item.invalidatedBy).map(item=>({requestId:item.requestId,answer:clone(item.answer),inputVersion:item.inputVersion||current}));return payload;
}
function intakeUnits(project,payload,inputVersion){
  const units=[];
  for(const name of globalThis.closedLoopWorkflowSchema?.HUMAN_INTAKE_FIELDS||[]){const values=materialUnitValues(payload?.[name]);values.forEach((rawValue,index)=>{const rawValueSha256=hash.sha256Value(rawValue),inputUnitId=`INPUT-UNIT-${hash.sha256Value({inputVersion,sourceField:name,sourceLocation:index,rawValueSha256}).slice(0,20).toUpperCase()}`;units.push({inputUnitId,sourceKind:'HUMAN_JOB_INPUT',sourceField:name,sourceLocation:`${name}[${index}]`,rawValue,rawValueSha256});});}
  for(const [index,item] of safe(payload?.clarifications).entries()){for(const [partIndex,rawValue] of materialUnitValues(item?.answer).entries()){const rawValueSha256=hash.sha256Value(rawValue),inputUnitId=`INPUT-UNIT-${hash.sha256Value({inputVersion,sourceField:'CLARIFICATION',sourceLocation:`${index}.${partIndex}`,rawValueSha256}).slice(0,20).toUpperCase()}`;units.push({inputUnitId,sourceKind:'HUMAN_CLARIFICATION',sourceField:'CLARIFICATION',sourceLocation:`clarifications[${index}].answer[${partIndex}]`,requestId:item?.requestId||null,rawValue,rawValueSha256});}}
  return units;
}
function currentStageAcceptedChange(project,stage){return acceptedChanges(project,stage).at(-1)||null;}
function ensureIntakeCoverageManifest(project){
  project.projectData.intakeCoverageManifests=safe(project.projectData.intakeCoverageManifests);const inputVersion=String(project.job.CURRENT_INPUT_VERSION||'INPUT-v001'),payload=inputPayload(project),inputSha256=hash.sha256Value(payload),signature=hash.sha256Value({jobId:project.job.JOB_ID,inputVersion,inputSha256}),manifestId=`INTAKE-MANIFEST-${signature.slice(0,20).toUpperCase()}`;
  let manifest=project.projectData.intakeCoverageManifests.find(item=>item.manifestId===manifestId);if(!manifest){const priorCapturedUnits=materialUnitValues(project.job.INPUT_SET_CONTENTS).map((rawValue,index)=>{const rawValueSha256=hash.sha256Value(rawValue),inputUnitId=`PRIOR-CAPTURE-UNIT-${hash.sha256Value({inputVersion,sourceField:'INPUT_SET_CONTENTS',sourceLocation:index,rawValueSha256}).slice(0,20).toUpperCase()}`;return {inputUnitId,sourceKind:'PRIOR_STAGE01_CAPTURE_EVIDENCE',sourceField:'INPUT_SET_CONTENTS',sourceLocation:`PRIOR_STAGE01_CAPTURE[${index}]`,rawValue,rawValueSha256};});manifest={schema:'closed-loop-intake-coverage-manifest/1',manifestId,jobId:project.job.JOB_ID,inputVersion,inputSha256,units:[...intakeUnits(project,payload,inputVersion),...priorCapturedUnits],classifications:[],capturedMaterialUnits:[],coverage:0,status:'PENDING_STAGE_01_ACCOUNTING',acceptedStage1ChangeId:null,rawResponseId:null,revisions:[],createdAt:now()};project.projectData.intakeCoverageManifests.push(manifest);}
  const accepted=currentStageAcceptedChange(project,1),accounting=safe(project.stages[1]?.agentData?.INTAKE_ACCOUNTING),evaluation=evaluateIntakeAccounting(project,accounting,{manifest});
  if(accepted&&evaluation.complete){manifest.classifications=clone(accounting);manifest.capturedMaterialUnits=materialUnitValues(project.job.INPUT_SET_CONTENTS).map((rawValue,index)=>{const rawValueSha256=hash.sha256Value(rawValue);return {inputUnitId:`CAPTURED-UNIT-${hash.sha256Value({inputVersion,acceptedChangeId:accepted.changeId,index,rawValueSha256}).slice(0,20).toUpperCase()}`,sourceKind:'STAGE01_CAPTURED_MATERIAL',sourceField:'INPUT_SET_CONTENTS',sourceLocation:`INPUT_SET_CONTENTS[${index}]`,rawValue,rawValueSha256,acceptedChangeId:accepted.changeId};});manifest.coverage=1;manifest.status='COMPLETE';manifest.acceptedStage1ChangeId=accepted.changeId;manifest.rawResponseId=accepted.rawResponseId||null;}else{manifest.classifications=[];manifest.capturedMaterialUnits=[];manifest.coverage=evaluation.coverage;manifest.status=accepted?'INCOMPLETE_STAGE_01_ACCOUNTING':'PENDING_STAGE_01_ACCOUNTING';manifest.acceptedStage1ChangeId=accepted?.changeId||null;manifest.rawResponseId=accepted?.rawResponseId||null;}
  const stateHash=hash.sha256Value({inputSha256:manifest.inputSha256,units:manifest.units,classifications:manifest.classifications,capturedMaterialUnits:manifest.capturedMaterialUnits,coverage:manifest.coverage,status:manifest.status,acceptedStage1ChangeId:manifest.acceptedStage1ChangeId,rawResponseId:manifest.rawResponseId});const last=manifest.revisions.at(-1);if(last?.sha256!==stateHash)manifest.revisions.push({sha256:stateHash,createdAt:now(),coverage:manifest.coverage,status:manifest.status,acceptedStage1ChangeId:manifest.acceptedStage1ChangeId});manifest.manifestSha256=stateHash;project.job.INPUT_SET_HASH_OR_MANIFEST=stateHash;return manifest;
}
function currentIntakeCoverageManifest(project){return ensureIntakeCoverageManifest(project);}
function evaluateIntakeAccounting(project,accounting,{manifest=null}={}){
  const target=manifest||project.projectData?.intakeCoverageManifests?.find(item=>item.inputVersion===project.job.CURRENT_INPUT_VERSION&&item.inputSha256===hash.sha256Value(inputPayload(project)))||ensureIntakeCoverageManifest(project),expected=target?.units||[],issues=[],seen=new Set();
  for(const [index,item] of safe(accounting).entries()){if(!item||typeof item!=='object'||Array.isArray(item)){issues.push(`INTAKE_ACCOUNTING[${index}] must be an object.`);continue;}const keys=Object.keys(item);for(const key of keys)if(!['inputUnitId','disposition','reason'].includes(key))issues.push(`INTAKE_ACCOUNTING[${index}] has unknown property ${key}.`);const id=String(item.inputUnitId||'');if(!id){issues.push(`INTAKE_ACCOUNTING[${index}] is missing inputUnitId.`);continue;}if(seen.has(id))issues.push(`INTAKE_ACCOUNTING duplicates ${id}.`);seen.add(id);if(!expected.some(unit=>unit.inputUnitId===id))issues.push(`INTAKE_ACCOUNTING references unknown ${id}.`);if(!INTAKE_ACCOUNTING_DISPOSITIONS.includes(String(item.disposition||'')))issues.push(`INTAKE_ACCOUNTING ${id} has invalid disposition.`);if(['UNRESOLVED_HUMAN_ONLY','LATER_RESOLVABLE','INAPPLICABLE'].includes(String(item.disposition||''))&&!String(item.reason||'').trim())issues.push(`INTAKE_ACCOUNTING ${id} requires a reason.`);}
  const missing=expected.map(unit=>unit.inputUnitId).filter(id=>!seen.has(id));if(missing.length)issues.push(`INTAKE_ACCOUNTING omitted ${missing.join(', ')}.`);const coverage=expected.length?Math.min(1,(expected.length-missing.length)/expected.length):1;return {complete:issues.length===0&&coverage===1,coverage,expectedIds:expected.map(unit=>unit.inputUnitId),missingIds:missing,issues};
}
function obligationSourceUnits(project){
  const intake=ensureIntakeCoverageManifest(project),out=[];const add=(sourceKind,sourceId,sourceField,sourceLocation,rawValue,provenance={})=>{for(const [index,value] of materialUnitValues(rawValue).entries()){const rawValueSha256=hash.sha256Value(value),obligationId=`OBLIGATION-${hash.sha256Value({sourceKind,sourceId,sourceField,sourceLocation,index,rawValueSha256}).slice(0,20).toUpperCase()}`;out.push({obligationId,sourceKind,sourceId,sourceField,sourceLocation:`${sourceLocation}[${index}]`,rawValue:value,rawValueSha256,...clone(provenance)});}};
  for(const unit of [...safe(intake.units),...safe(intake.capturedMaterialUnits)])add(unit.sourceKind,unit.inputUnitId,unit.sourceField,unit.sourceLocation,unit.rawValue,{inputVersion:intake.inputVersion,intakeManifestId:intake.manifestId});
  const accepted1=currentStageAcceptedChange(project,1);if(accepted1){for(const field of ['EXACT_DELIVERABLE_REQUESTED','ASSUMPTIONS','UNKNOWN_INFORMATION'])add('STAGE01_JOB_DEFINITION',accepted1.changeId,field,field,project.job[field],{rawResponseId:accepted1.rawResponseId||null});}
  const researchFields=['MANDATORY_STATEMENTS','RECOMMENDATIONS','OPTIONAL_PRACTICES','PROHIBITIONS','EXCEPTIONS','DEPENDENCIES','APPLICABILITY_FACTS','RESTRICTIONS','INVALIDATING_MATERIAL'];
  for(const record of recordsForCurrentScope(project,'research').filter(record=>Number(record.stage)===3)){const id=recordId(record,'research');for(const field of researchFields)add('STAGE03_RESEARCH',id,field,`${id}.${field}`,recordValue(record,field),{sourceId:recordValue(record,'SOURCE_ID')||null});}
  for(const record of recordsForCurrentScope(project,'candidateRequirements').filter(record=>Number(record.stage)===3)){const id=recordId(record,'candidateRequirements');add('STAGE03_CANDIDATE_REQUIREMENT',id,'CANDIDATE_OBLIGATION',`${id}.CANDIDATE_OBLIGATION`,recordValue(record,'CANDIDATE_OBLIGATION'),{sourceId:recordValue(record,'SOURCE_ID')||null,evidence:recordValue(record,'EVIDENCE')||null});}
  return out;
}
function ensureObligationManifest(project){
  project.projectData.obligationManifests=safe(project.projectData.obligationManifests);const intake=ensureIntakeCoverageManifest(project),accepted1=currentStageAcceptedChange(project,1),accepted3=currentStageAcceptedChange(project,3),units=obligationSourceUnits(project),sourceSignature=hash.sha256Value({jobId:project.job.JOB_ID,inputVersion:project.job.CURRENT_INPUT_VERSION,sourceSetVersion:project.job.CURRENT_SOURCE_SET_VERSION||'',intakeManifestSha256:intake.manifestSha256,acceptedStage1ChangeId:accepted1?.changeId||null,acceptedStage3ChangeId:accepted3?.changeId||null,units:units.map(unit=>({obligationId:unit.obligationId,rawValueSha256:unit.rawValueSha256}))}),manifestId=`OBLIGATION-MANIFEST-${sourceSignature.slice(0,20).toUpperCase()}`;
  let manifest=project.projectData.obligationManifests.find(item=>item.manifestId===manifestId);if(!manifest){manifest={schema:'closed-loop-obligation-manifest/1',manifestId,jobId:project.job.JOB_ID,inputVersion:project.job.CURRENT_INPUT_VERSION,sourceSetVersion:project.job.CURRENT_SOURCE_SET_VERSION||'',intakeManifestId:intake.manifestId,intakeManifestSha256:intake.manifestSha256,acceptedStage1ChangeId:accepted1?.changeId||null,acceptedStage3ChangeId:accepted3?.changeId||null,sourceSignature,obligations:units,coverage:0,status:'PENDING_STAGE_04_ACCOUNTING',revisions:[],createdAt:now()};project.projectData.obligationManifests.push(manifest);}
  const accepted4=currentStageAcceptedChange(project,4),accounting=safe(project.stages[4]?.agentData?.OBLIGATION_ACCOUNTING),evaluation=evaluateObligationAccounting(project,accounting,{manifest,requirementTempKeys:recordsForCurrentScope(project,'requirements').filter(record=>Number(record.stage)===4).map(record=>record.temporaryKey).filter(Boolean)});manifest.coverage=evaluation.coverage;manifest.status=accepted4&&evaluation.complete?'COMPLETE':accepted4?'INCOMPLETE_STAGE_04_ACCOUNTING':'PENDING_STAGE_04_ACCOUNTING';manifest.acceptedStage4ChangeId=accepted4?.changeId||null;manifest.rawResponseId=accepted4?.rawResponseId||null;manifest.accounting=accepted4?clone(accounting):[];const stateHash=hash.sha256Value({sourceSignature,coverage:manifest.coverage,status:manifest.status,acceptedStage4ChangeId:manifest.acceptedStage4ChangeId,accounting:manifest.accounting});const last=manifest.revisions.at(-1);if(last?.sha256!==stateHash)manifest.revisions.push({sha256:stateHash,createdAt:now(),coverage:manifest.coverage,status:manifest.status,acceptedStage4ChangeId:manifest.acceptedStage4ChangeId});manifest.manifestSha256=stateHash;return manifest;
}
function currentObligationManifest(project){return ensureObligationManifest(project);}
function evaluateObligationAccounting(project,accounting,{manifest=null,requirementTempKeys=null}={}){
  const target=manifest||ensureObligationManifest(project),expected=target?.obligations||[],issues=[],seen=new Set(),allowedRequirementKeys=new Set(requirementTempKeys||recordsForCurrentScope(project,'requirements').filter(record=>Number(record.stage)===4).map(record=>record.temporaryKey).filter(Boolean));
  for(const [index,item] of safe(accounting).entries()){if(!item||typeof item!=='object'||Array.isArray(item)){issues.push(`OBLIGATION_ACCOUNTING[${index}] must be an object.`);continue;}for(const key of Object.keys(item))if(!['obligationId','disposition','requirementTempKeys','reason'].includes(key))issues.push(`OBLIGATION_ACCOUNTING[${index}] has unknown property ${key}.`);const id=String(item.obligationId||'');if(!id){issues.push(`OBLIGATION_ACCOUNTING[${index}] is missing obligationId.`);continue;}if(seen.has(id))issues.push(`OBLIGATION_ACCOUNTING duplicates ${id}.`);seen.add(id);if(!expected.some(unit=>unit.obligationId===id))issues.push(`OBLIGATION_ACCOUNTING references unknown ${id}.`);const disposition=String(item.disposition||'');if(!OBLIGATION_ACCOUNTING_DISPOSITIONS.includes(disposition))issues.push(`OBLIGATION_ACCOUNTING ${id} has invalid disposition.`);const keys=safe(item.requirementTempKeys);if(disposition==='REQUIREMENT'){if(!keys.length)issues.push(`OBLIGATION_ACCOUNTING ${id} must map to at least one requirement tempKey.`);for(const key of keys)if(!allowedRequirementKeys.has(String(key)))issues.push(`OBLIGATION_ACCOUNTING ${id} maps to unknown requirement tempKey ${key}.`);}else{if(keys.length)issues.push(`OBLIGATION_ACCOUNTING ${id} must not map requirementTempKeys for disposition ${disposition}.`);if(!String(item.reason||'').trim())issues.push(`OBLIGATION_ACCOUNTING ${id} requires a reason.`);}}
  const missing=expected.map(unit=>unit.obligationId).filter(id=>!seen.has(id));if(missing.length)issues.push(`OBLIGATION_ACCOUNTING omitted ${missing.join(', ')}.`);const coverage=expected.length?Math.min(1,(expected.length-missing.length)/expected.length):1;return {complete:issues.length===0&&coverage===1,coverage,expectedIds:expected.map(unit=>unit.obligationId),missingIds:missing,issues};
}
function intakeManifestContext(project){const manifest=ensureIntakeCoverageManifest(project),evaluation=evaluateIntakeAccounting(project,safe(project.stages[1]?.agentData?.INTAKE_ACCOUNTING),{manifest});return {manifestId:manifest.manifestId,manifestSha256:manifest.manifestSha256,inputVersion:manifest.inputVersion,inputSha256:manifest.inputSha256,unitIds:manifest.units.map(unit=>unit.inputUnitId),capturedMaterialUnitIds:manifest.capturedMaterialUnits.map(unit=>unit.inputUnitId),coverage:evaluation.coverage,status:manifest.status};}
function obligationManifestContext(project){const manifest=ensureObligationManifest(project),evaluation=evaluateObligationAccounting(project,safe(project.stages[4]?.agentData?.OBLIGATION_ACCOUNTING),{manifest});return {manifestId:manifest.manifestId,manifestSha256:manifest.manifestSha256,inputVersion:manifest.inputVersion,sourceSetVersion:manifest.sourceSetVersion,obligationIds:manifest.obligations.map(unit=>unit.obligationId),coverage:evaluation.coverage,status:manifest.status};}
