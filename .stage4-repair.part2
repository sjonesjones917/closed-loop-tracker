  const migrationAnchor="  if(p.schema!=='human-project/30')throw new Error(`Unsupported project schema: ${p.schema||'MISSING'}`);";
  const migrationBlock=`  if(p.schema==='closed-loop-project/2'&&p.workflow===WORKFLOW_ID&&Number(p.stageCount)===STAGE_COUNT){\n    const migrated=JSON.parse(JSON.stringify(p)),original=JSON.parse(JSON.stringify(p));\n    migrated.schema=PROJECT_SCHEMA;\n    migrated.projectData=migrated.projectData&&typeof migrated.projectData==='object'?migrated.projectData:{};\n    migrated.projectData.migrationArchives=Array.isArray(migrated.projectData.migrationArchives)?migrated.projectData.migrationArchives:[];\n    migrated.projectData.historicalImportRecords=Array.isArray(migrated.projectData.historicalImportRecords)?migrated.projectData.historicalImportRecords:[];\n    if(migrated.projectData.stageRecords&&Object.keys(migrated.projectData.stageRecords).length){migrated.projectData.historicalImportRecords.push({kind:'LEGACY_STAGE_RECORDS',schema:'closed-loop-project/2',records:JSON.parse(JSON.stringify(migrated.projectData.stageRecords))});delete migrated.projectData.stageRecords;}\n    if(migrated.projectData.fullProject&&Object.keys(migrated.projectData.fullProject).length)delete migrated.projectData.fullProject;\n    migrated.projectData.migrationArchives.push({kind:'MIGRATION_SOURCE',schema:'closed-loop-project/2',targetSchema:PROJECT_SCHEMA,preservedAt:new Date().toISOString(),payload:original});\n    return migrated;\n  }\n${migrationAnchor}`;
  s=mustReplace(s,migrationAnchor,migrationBlock,'/2 to /3 migration');
  write('workbook.js',s);
}

{
  let s=read('workflow-schema.js');
  s=mustReplace(s,"const RESPONSE_SCHEMA='closed-loop-stage-response/2';","const RESPONSE_SCHEMA='closed-loop-stage-response/3';",'response schema');
  s=mustReplace(s,"version:'closed-loop-workflow-schema/2'","version:'closed-loop-workflow-schema/3'",'schema implementation version');
  const oldOverrides=`const STAGE_FIELD_TYPE_OVERRIDES=Object.freeze({\n  '1':Object.freeze({DESIRED_SOURCE_COUNT:Object.freeze({valueType:'INTEGER',enumValues:Object.freeze([]),nullable:true,normalizerKey:null,closedProperties:null})}),\n  '2':Object.freeze({SOURCE_APPLICABILITY_DETERMINATION:Object.freeze({valueType:'STRING',enumValues:Object.freeze(['APPLICABLE_SOURCES_ESTABLISHED','NO_APPLICABLE_EXTERNAL_SOURCE','UNDETERMINED']),nullable:false,normalizerKey:null,closedProperties:null})})\n});`;
  const newOverrides=`const STAGE_FIELD_TYPE_OVERRIDES=Object.freeze({\n  '1':Object.freeze({\n    DESIRED_SOURCE_COUNT:Object.freeze({valueType:'INTEGER',enumValues:Object.freeze([]),nullable:true,normalizerKey:null,closedProperties:null}),\n    INTAKE_ACCOUNTING:Object.freeze({valueType:'OBJECT_ARRAY',enumValues:Object.freeze([]),nullable:false,normalizerKey:null,closedProperties:null})\n  }),\n  '2':Object.freeze({SOURCE_APPLICABILITY_DETERMINATION:Object.freeze({valueType:'STRING',enumValues:Object.freeze(['APPLICABLE_SOURCES_ESTABLISHED','NO_APPLICABLE_EXTERNAL_SOURCE','UNDETERMINED']),nullable:false,normalizerKey:null,closedProperties:null})}),\n  '4':Object.freeze({OBLIGATION_ACCOUNTING:Object.freeze({valueType:'OBJECT_ARRAY',enumValues:Object.freeze([]),nullable:false,normalizerKey:null,closedProperties:null})})\n});`;
  s=mustReplace(s,oldOverrides,newOverrides,'stage accounting field types');
  write('workflow-schema.js',s);
}

{
  let s=read('workflow-engine.js');
  s=mustReplace(s,"'responseDispositions','executionFailures']","'responseDispositions','executionFailures','intakeCoverageManifests','obligationManifests']",'manifest infrastructure collections');
  const anchor="function recordHumanInputVersion(project,changedFields=[],operator='HUMAN_OPERATOR'){";
  mustInclude(s,anchor,'recordHumanInputVersion');
  const helpers=read('.stage4-engine-helper.tmp');
  if(!s.includes('function currentIntakeCoverageManifest(project)'))s=s.replace(anchor,helpers+'\n'+anchor);
  s=mustReplace(s,'function recalculate(project){\n  ensureShape(project);','function recalculate(project){\n  ensureShape(project);\n  ensureIntakeCoverageManifest(project);\n  if(currentStageAcceptedChange(project,1))ensureObligationManifest(project);','recalculate manifest refresh');
  const stage1=`    case 1:{\n      if(!String(project.job.EXACT_USER_OBJECTIVE_VERBATIM||'').trim())reasons.push('Verbatim User Job Input is required.');\n      requireAccepted();\n      const latest=changes.at(-1),confirmed=safe(project.projectData.stageConfirmations).some(item=>Number(item.stage)===1&&item.confirmed===true&&!item.invalidatedBy&&item.acceptedChangeId===latest?.changeId&&item.inputVersion===project.job.CURRENT_INPUT_VERSION);\n      if(!confirmed)reasons.push('Human confirmation bound to the current accepted change and input version is required.');\n      break;`;
  const stage1New=`    case 1:{\n      if(!String(project.job.EXACT_USER_OBJECTIVE_VERBATIM||'').trim())reasons.push('Verbatim User Job Input is required.');\n      requireAccepted();\n      const latest=changes.at(-1),confirmed=safe(project.projectData.stageConfirmations).some(item=>Number(item.stage)===1&&item.confirmed===true&&!item.invalidatedBy&&item.acceptedChangeId===latest?.changeId&&item.inputVersion===project.job.CURRENT_INPUT_VERSION);\n      if(!confirmed)reasons.push('Human confirmation bound to the current accepted change and input version is required.');\n      const intake=currentIntakeCoverageManifest(project),intakeAccounting=evaluateIntakeAccounting(project,safe(project.stages[1]?.agentData?.INTAKE_ACCOUNTING),{manifest:intake});\n      if(!intakeAccounting.complete)reasons.push(...intakeAccounting.issues.map(item=>\`Stage 01 intake accounting: ${'${item}'}\`));\n      if(intake.status!=='COMPLETE')reasons.push('Stage 01 intake coverage manifest is not complete for the current input version.');\n      break;`;
  s=mustReplace(s,stage1,stage1New,'Stage 01 intake gate');
  // Exact Stage 04 source is located by slice so template interpolation cannot alter the anchor.
  const stage4Start=s.indexOf("    case 4:{\n      requireAccepted();requireCount('requirements',1);");
  const stage5Start=s.indexOf("    case 5:",stage4Start);
  if(stage4Start<0||stage5Start<0)throw new Error('Stage 04 gate block missing');
  const stage4New=`    case 4:{\n      requireAccepted();requireCount('requirements',1);\n      const obligationManifest=currentObligationManifest(project),requirementTempKeys=collection('requirements').map(record=>record.temporaryKey).filter(Boolean),obligationAccounting=evaluateObligationAccounting(project,safe(project.stages[4]?.agentData?.OBLIGATION_ACCOUNTING),{manifest:obligationManifest,requirementTempKeys});\n      if(!obligationAccounting.complete)reasons.push(...obligationAccounting.issues.map(item=>\`Stage 04 obligation accounting: ${'${item}'}\`));\n      if(obligationManifest.status!=='COMPLETE')reasons.push('Stage 04 obligation manifest is not completely accounted for in the current scope.');\n      for(const req of collection('requirements')){\n        for(const name of schema.RECORD_SCHEMAS.requirements.required)if(!String(recordValue(req,name)||'').trim())reasons.push(\`Requirement ${'${recordId(req,\'requirements\')}'} missing ${'${name}'}.\`);\n        const sourceId=String(recordValue(req,'SOURCE_ID')||'').trim(),userRelationship=String(recordValue(req,'USER_INPUT_RELATIONSHIP')||'').trim();if(!sourceId&&!userRelationship)reasons.push(\`Requirement ${'${recordId(req,\'requirements\')}'} lacks source provenance or explicit User Job Input relationship.\`);\n      }\n      break;\n    }\n`;
  s=s.slice(0,stage4Start)+stage4New+s.slice(stage5Start);
  s=mustReplace(s,"case 1:Object.assign(derived,{JOB_ID:project.job.JOB_ID,DATE_OPENED:project.job.DATE_OPENED,INPUT_SET_VERSION:project.job.CURRENT_INPUT_VERSION,INPUT_SET_HASH_OR_MANIFEST:project.job.INPUT_SET_HASH_OR_MANIFEST||'UNKNOWN',JOB_RECORD_STATUS:project.stages[1].status==='COMPLETE'?'READY':'NOT READY'});break;","case 1:{const manifest=currentIntakeCoverageManifest(project),accounting=evaluateIntakeAccounting(project,safe(project.stages[1]?.agentData?.INTAKE_ACCOUNTING),{manifest});Object.assign(derived,{JOB_ID:project.job.JOB_ID,DATE_OPENED:project.job.DATE_OPENED,INPUT_SET_VERSION:project.job.CURRENT_INPUT_VERSION,INPUT_SET_HASH_OR_MANIFEST:manifest.manifestSha256||project.job.INPUT_SET_HASH_OR_MANIFEST||'UNKNOWN',JOB_RECORD_STATUS:project.stages[1].status==='COMPLETE'?'READY':'NOT READY',INTAKE_ACCOUNTING_COVERAGE:accounting.coverage,INTAKE_MANIFEST_ID:manifest.manifestId});break;}",'Stage 01 derived manifest');
  s=mustReplace(s,"case 4:Object.assign(derived,{REQUIREMENTS_VERSION:project.job.CURRENT_REQUIREMENTS_VERSION||'NOT APPLICABLE',TOTAL_REQUIREMENTS:recordsForCurrentScope(project,'requirements').length,MANDATORY_REQUIREMENTS:metrics.mandatoryRequirementCount});break;","case 4:{const manifest=currentObligationManifest(project),accounting=evaluateObligationAccounting(project,safe(project.stages[4]?.agentData?.OBLIGATION_ACCOUNTING),{manifest});Object.assign(derived,{REQUIREMENTS_VERSION:project.job.CURRENT_REQUIREMENTS_VERSION||'NOT APPLICABLE',TOTAL_REQUIREMENTS:recordsForCurrentScope(project,'requirements').length,MANDATORY_REQUIREMENTS:metrics.mandatoryRequirementCount,OBLIGATION_ACCOUNTING_COVERAGE:accounting.coverage,OBLIGATION_MANIFEST_ID:manifest.manifestId});break;}",'Stage 04 derived manifest');
  s=mustReplace(s,'recordHumanInputVersion,recordStageConfirmation,recordReleaseDetermination,acceptedControlEvents,constructEvidenceChains,verifyArtifactIdentity','recordHumanInputVersion,currentIntakeCoverageManifest,currentObligationManifest,evaluateIntakeAccounting,evaluateObligationAccounting,intakeManifestContext,obligationManifestContext,recordStageConfirmation,recordReleaseDetermination,acceptedControlEvents,constructEvidenceChains,verifyArtifactIdentity','engine manifest exports');
  write('workflow-engine.js',s);
}
